<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_JobAbility"
                  targetNamespace="http://jobability.local/bpmn">
  <bpmn:collaboration id="Collaboration_JobAbility">
    <bpmn:participant id="Participant_JobAbility" name="JobAbility: трудоустройство людей с ограниченными возможностями" processRef="Process_JobAbilityEmployment"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_JobAbilityEmployment" name="Итоговый бизнес-процесс JobAbility" isExecutable="false">
    <bpmn:documentation>Три дорожки: Работодатель, Сервис JobAbility, Соискатель. Процесс отражает реальные операции сайта: регистрация, вход, создание и модерация вакансии, поиск вакансии, формирование заявки, просмотр откликов и фиксация итогового статуса.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_JobAbility"><bpmn:lane id="Lane_Employer" name="Работодатель"><bpmn:flowNodeRef>Start_Process</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_EmployerAuth</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_OpenEmployerCabinet</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CreateVacancy</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SubmitVacancy</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ReadRejectReason</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ViewResponses</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ReviewCandidate</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_DecideCandidate</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Service" name="Сервис JobAbility"><bpmn:flowNodeRef>Task_CheckEmployerRole</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SavePendingVacancy</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_VacancyApproved</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RejectVacancy</bpmn:flowNodeRef><bpmn:flowNodeRef>End_RejectedVacancy</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_PublishVacancy</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ResetVacancyCache</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CheckApplicantRole</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SaveApplicationDraft</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_FormApplication</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_ResponseAccepted</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_FinishApplication</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RejectApplication</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SaveFinalStatus</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Applicant" name="Соискатель"><bpmn:flowNodeRef>Task_BrowseVacancies</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_FilterVacancies</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_OpenVacancy</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ApplicantAuth</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AddVacancyToDraft</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_FillApplication</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SubmitApplication</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ViewFinalStatus</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Process</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Start_Process" name="Нужно разместить вакансию"><bpmn:outgoing>Flow_01</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="Task_EmployerAuth" name="Регистрация / вход работодателя"><bpmn:incoming>Flow_01</bpmn:incoming><bpmn:outgoing>Flow_02</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_OpenEmployerCabinet" name="Открыть кабинет работодателя"><bpmn:incoming>Flow_02</bpmn:incoming><bpmn:outgoing>Flow_03</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_CreateVacancy" name="Заполнить вакансию и материалы"><bpmn:incoming>Flow_03</bpmn:incoming><bpmn:outgoing>Flow_04</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_SubmitVacancy" name="Отправить вакансию на публикацию"><bpmn:incoming>Flow_04</bpmn:incoming><bpmn:outgoing>Flow_05</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_ReadRejectReason" name="Получить причину отклонения"><bpmn:incoming>Flow_09</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_ViewResponses" name="Открыть отклики на вакансии"><bpmn:incoming>Flow_23</bpmn:incoming><bpmn:outgoing>Flow_24</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_ReviewCandidate" name="Изучить заявку кандидата"><bpmn:incoming>Flow_24</bpmn:incoming><bpmn:outgoing>Flow_25</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_DecideCandidate" name="Принять решение по кандидату"><bpmn:incoming>Flow_25</bpmn:incoming><bpmn:outgoing>Flow_26</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Task_CheckEmployerRole" name="Проверить авторизацию и роль employer"><bpmn:incoming>Flow_05</bpmn:incoming><bpmn:outgoing>Flow_06</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="Task_SavePendingVacancy" name="Сохранить вакансию со статусом PENDING"><bpmn:incoming>Flow_06</bpmn:incoming><bpmn:outgoing>Flow_07</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Gateway_VacancyApproved" name="Вакансия корректна?"><bpmn:incoming>Flow_07</bpmn:incoming><bpmn:outgoing>Flow_08</bpmn:outgoing><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Task_RejectVacancy" name="Отклонить вакансию и записать причину"><bpmn:incoming>Flow_08</bpmn:incoming><bpmn:outgoing>Flow_09</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="End_RejectedVacancy" name="Вакансия отклонена"><bpmn:incoming>Flow_10</bpmn:incoming></bpmn:endEvent><bpmn:serviceTask id="Task_PublishVacancy" name="Опубликовать вакансию APPROVED"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="Task_ResetVacancyCache" name="Сбросить кеш каталога Redis"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="Task_CheckApplicantRole" name="Проверить авторизацию и роль applicant"><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_21</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="Task_SaveApplicationDraft" name="Сохранить строки заявки и пересчитать сумму"><bpmn:incoming>Flow_21</bpmn:incoming><bpmn:outgoing>Flow_22</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="Task_FormApplication" name="Перевести заявку в статус FORMED"><bpmn:incoming>Flow_22</bpmn:incoming><bpmn:outgoing>Flow_23</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Gateway_ResponseAccepted" name="Кандидат подходит?"><bpmn:incoming>Flow_26</bpmn:incoming><bpmn:outgoing>Flow_27</bpmn:outgoing><bpmn:outgoing>Flow_28</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Task_FinishApplication" name="Установить статус FINISHED"><bpmn:incoming>Flow_27</bpmn:incoming><bpmn:outgoing>Flow_29</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="Task_RejectApplication" name="Установить статус REJECTED"><bpmn:incoming>Flow_28</bpmn:incoming><bpmn:outgoing>Flow_30</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="Task_SaveFinalStatus" name="Сохранить итоговый статус заявки"><bpmn:incoming>Flow_29</bpmn:incoming><bpmn:incoming>Flow_30</bpmn:incoming><bpmn:outgoing>Flow_31</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="Task_BrowseVacancies" name="Открыть каталог вакансий"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_FilterVacancies" name="Найти и отфильтровать вакансии"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_OpenVacancy" name="Открыть карточку вакансии"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_ApplicantAuth" name="Регистрация / вход соискателя"><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_AddVacancyToDraft" name="Добавить вакансию в черновик заявки"><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_FillApplication" name="Заполнить профиль, контакты и письмо"><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_SubmitApplication" name="Сформировать заявку"><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_ViewFinalStatus" name="Посмотреть итоговый статус в кабинете"><bpmn:incoming>Flow_31</bpmn:incoming><bpmn:outgoing>Flow_32</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="End_Process" name="Процесс завершен"><bpmn:incoming>Flow_32</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_01" name="" sourceRef="Start_Process" targetRef="Task_EmployerAuth"/><bpmn:sequenceFlow id="Flow_02" name="" sourceRef="Task_EmployerAuth" targetRef="Task_OpenEmployerCabinet"/><bpmn:sequenceFlow id="Flow_03" name="" sourceRef="Task_OpenEmployerCabinet" targetRef="Task_CreateVacancy"/><bpmn:sequenceFlow id="Flow_04" name="" sourceRef="Task_CreateVacancy" targetRef="Task_SubmitVacancy"/><bpmn:sequenceFlow id="Flow_05" name="" sourceRef="Task_SubmitVacancy" targetRef="Task_CheckEmployerRole"/><bpmn:sequenceFlow id="Flow_06" name="" sourceRef="Task_CheckEmployerRole" targetRef="Task_SavePendingVacancy"/><bpmn:sequenceFlow id="Flow_07" name="" sourceRef="Task_SavePendingVacancy" targetRef="Gateway_VacancyApproved"/><bpmn:sequenceFlow id="Flow_08" name="нет" sourceRef="Gateway_VacancyApproved" targetRef="Task_RejectVacancy"/><bpmn:sequenceFlow id="Flow_09" name="" sourceRef="Task_RejectVacancy" targetRef="Task_ReadRejectReason"/><bpmn:sequenceFlow id="Flow_10" name="" sourceRef="Task_ReadRejectReason" targetRef="End_RejectedVacancy"/><bpmn:sequenceFlow id="Flow_11" name="да" sourceRef="Gateway_VacancyApproved" targetRef="Task_PublishVacancy"/><bpmn:sequenceFlow id="Flow_12" name="" sourceRef="Task_PublishVacancy" targetRef="Task_ResetVacancyCache"/><bpmn:sequenceFlow id="Flow_13" name="вакансия опубликована" sourceRef="Task_ResetVacancyCache" targetRef="Task_BrowseVacancies"/><bpmn:sequenceFlow id="Flow_14" name="" sourceRef="Task_BrowseVacancies" targetRef="Task_FilterVacancies"/><bpmn:sequenceFlow id="Flow_15" name="" sourceRef="Task_FilterVacancies" targetRef="Task_OpenVacancy"/><bpmn:sequenceFlow id="Flow_16" name="" sourceRef="Task_OpenVacancy" targetRef="Task_ApplicantAuth"/><bpmn:sequenceFlow id="Flow_17" name="" sourceRef="Task_ApplicantAuth" targetRef="Task_AddVacancyToDraft"/><bpmn:sequenceFlow id="Flow_18" name="" sourceRef="Task_AddVacancyToDraft" targetRef="Task_FillApplication"/><bpmn:sequenceFlow id="Flow_19" name="" sourceRef="Task_FillApplication" targetRef="Task_SubmitApplication"/><bpmn:sequenceFlow id="Flow_20" name="" sourceRef="Task_SubmitApplication" targetRef="Task_CheckApplicantRole"/><bpmn:sequenceFlow id="Flow_21" name="" sourceRef="Task_CheckApplicantRole" targetRef="Task_SaveApplicationDraft"/><bpmn:sequenceFlow id="Flow_22" name="" sourceRef="Task_SaveApplicationDraft" targetRef="Task_FormApplication"/><bpmn:sequenceFlow id="Flow_23" name="заявка сформирована" sourceRef="Task_FormApplication" targetRef="Task_ViewResponses"/><bpmn:sequenceFlow id="Flow_24" name="" sourceRef="Task_ViewResponses" targetRef="Task_ReviewCandidate"/><bpmn:sequenceFlow id="Flow_25" name="" sourceRef="Task_ReviewCandidate" targetRef="Task_DecideCandidate"/><bpmn:sequenceFlow id="Flow_26" name="" sourceRef="Task_DecideCandidate" targetRef="Gateway_ResponseAccepted"/><bpmn:sequenceFlow id="Flow_27" name="да" sourceRef="Gateway_ResponseAccepted" targetRef="Task_FinishApplication"/><bpmn:sequenceFlow id="Flow_28" name="нет" sourceRef="Gateway_ResponseAccepted" targetRef="Task_RejectApplication"/><bpmn:sequenceFlow id="Flow_29" name="" sourceRef="Task_FinishApplication" targetRef="Task_SaveFinalStatus"/><bpmn:sequenceFlow id="Flow_30" name="" sourceRef="Task_RejectApplication" targetRef="Task_SaveFinalStatus"/><bpmn:sequenceFlow id="Flow_31" name="" sourceRef="Task_SaveFinalStatus" targetRef="Task_ViewFinalStatus"/><bpmn:sequenceFlow id="Flow_32" name="" sourceRef="Task_ViewFinalStatus" targetRef="End_Process"/><bpmn:textAnnotation id="TextAnnotation_Description"><bpmn:text>Итоговый процесс JobAbility: работодатель публикует вакансию, сервис проверяет и размещает ее, соискатель выбирает вакансию и формирует заявку, работодатель рассматривает отклик, сервис фиксирует итоговый статус.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
